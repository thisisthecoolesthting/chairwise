---
export interface Props {
  title?: string;
  subtitle?: string;
}
const { title = 'Get the best chair deals', subtitle = 'Ergonomic chair & desk price drops, once a week. No spam.' } = Astro.props;
---
<div class="mt-10 rounded-3xl border border-ink-200/30 bg-ink-50/30 p-6 md:p-8">
  <h2 class="font-display text-2xl text-ink-900 mb-2">{title}</h2>
  <p class="text-ink-700 mb-4">{subtitle}</p>
  <form data-rcc-subscribe data-rcc-site="chairwise.app" class="flex flex-col gap-3 sm:flex-row sm:items-end">
    <label class="flex-1">
      <span class="sr-only">Email</span>
      <input type="email" name="email" required autocomplete="email" placeholder="you@email.com" class="w-full rounded-2xl border border-ink-200 px-4 py-3 text-ink-900" />
    </label>
    <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
    <button type="submit" class="rounded-2xl bg-terracotta-600 px-6 py-3 text-white font-medium hover:bg-terracotta-700">Send me deals</button>
  </form>
</div>
